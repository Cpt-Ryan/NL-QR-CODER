<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <RootNamespace>QR_Code_Application</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <ApplicationIcon>qr-code.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="qr-code.ico" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\MainForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\MainForm.Designer.vb"><DependentUpon>MainForm.vb</DependentUpon></Compile>
    <EmbeddedResource Update="Forms\MainForm.resx"><DependentUpon>MainForm.vb</DependentUpon><LogicalName>QR_Code_Application.MainForm.resources</LogicalName></EmbeddedResource>
    <Compile Update="Forms\Panels\CeilingPanelForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Panels\CeilingPanelForm.Designer.vb"><DependentUpon>CeilingPanelForm.vb</DependentUpon></Compile>
    <EmbeddedResource Update="Forms\Panels\CeilingPanelForm.resx"><DependentUpon>CeilingPanelForm.vb</DependentUpon><LogicalName>QR_Code_Application.CeilingPanelForm.resources</LogicalName></EmbeddedResource>
    <Compile Update="Forms\Panels\CornerPanelForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Panels\CornerPanelForm.Designer.vb"><DependentUpon>CornerPanelForm.vb</DependentUpon></Compile>
    <EmbeddedResource Update="Forms\Panels\CornerPanelForm.resx"><DependentUpon>CornerPanelForm.vb</DependentUpon><LogicalName>QR_Code_Application.CornerPanelForm.resources</LogicalName></EmbeddedResource>
    <Compile Update="Forms\Panels\FloorPanelForm.vb" />
    <Compile Update="Forms\Panels\FloorPanelForm.Designer.vb"><DependentUpon>FloorPanelForm.vb</DependentUpon></Compile>
    <EmbeddedResource Update="Forms\Panels\FloorPanelForm.resx"><DependentUpon>FloorPanelForm.vb</DependentUpon><LogicalName>QR_Code_Application.FloorPanelForm.resources</LogicalName></EmbeddedResource>
    <Compile Update="Forms\Panels\TeePanelForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\Panels\TeePanelForm.Designer.vb"><DependentUpon>TeePanelForm.vb</DependentUpon></Compile>
    <EmbeddedResource Update="Forms\Panels\TeePanelForm.resx"><DependentUpon>TeePanelForm.vb</DependentUpon><LogicalName>QR_Code_Application.TeePanelForm.resources</LogicalName></EmbeddedResource>
    <Compile Update="Forms\Panels\WallPanelForm.vb" />
    <Compile Update="Forms\Panels\WallPanelForm.Designer.vb"><DependentUpon>WallPanelForm.vb</DependentUpon></Compile>
    <EmbeddedResource Update="Forms\Panels\WallPanelForm.resx"><DependentUpon>WallPanelForm.vb</DependentUpon><LogicalName>QR_Code_Application.WallPanelForm.resources</LogicalName></EmbeddedResource>
    <Compile Update="Forms\QrStringEditorForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\QrStringEditorForm.Designer.vb"><DependentUpon>QrStringEditorForm.vb</DependentUpon></Compile>
    <EmbeddedResource Update="Forms\QrStringEditorForm.resx"><DependentUpon>QrStringEditorForm.vb</DependentUpon><LogicalName>QR_Code_Application.QrStringEditorForm.resources</LogicalName></EmbeddedResource>
    <Compile Update="Forms\Dialogs\FoamDateDialog.vb"><SubType>Form</SubType></Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Images\Int OS Ceiling.png">
      <LogicalName>QR_Code_Application.Images.CeilingInteriorOutside.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Images\Int CNT Ceiling.png">
      <LogicalName>QR_Code_Application.Images.CeilingInteriorCenter.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Images\Ext Ceiling.png">
      <LogicalName>QR_Code_Application.Images.CeilingExterior.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Images\Int CNT Floor.png">
      <LogicalName>QR_Code_Application.Images.FloorInteriorCenter.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\INT OS Floor.png">
      <LogicalName>QR_Code_Application.Images.FloorInteriorOutside.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>